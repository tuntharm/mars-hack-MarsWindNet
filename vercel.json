{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/predict.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/model-info.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sensor/",
      "destination": "/sensor/index.html"
    }
  ]
}
