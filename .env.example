# Server-only environment variables for Vercel functions. Never prefix these with VITE_.
# Unset URL deliberately leaves the model disconnected. Production/preview require HTTPS.
MODEL_API_URL=
MODEL_API_TOKEN=

# Optional local adapter example (use with vercel dev; never hosted):
# MODEL_API_URL=http://127.0.0.1:8001

# Legacy IDW stub: explicit development-only opt-in, never the hosted model path.
# VITE_PREDICTION_MODE=stub
# VITE_PREDICT_URL=http://127.0.0.1:8000/predict
